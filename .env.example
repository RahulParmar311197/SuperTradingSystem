# Copy to .env and fill in real values. Never commit the real .env file.

# "development" (the default) accepts the placeholder secrets below so
# local dev/tests work with zero configuration. Set this to "production"
# in any real deployment -- doing so makes the app refuse to start if
# JWT_SECRET or CREDENTIALS_ENCRYPTION_KEY is still blank or a placeholder
# (see app/core/config.py's Settings._refuse_default_secrets_in_production).
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
# Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Comma/JSON-list of allowed browser origins, e.g. ["https://app.example.com"].
# Empty (the default) denies all cross-origin requests.
CORS_ORIGINS=

# Brute-force protection on /auth/login and /auth/register. Leave true in
# production; tests set this to false themselves (every request in a test
# suite shares one client "IP").
RATE_LIMIT_ENABLED=true

AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

DHAN_CLIENT_ID=
DHAN_SECRET=

UPSTOX_CLIENT_ID=
UPSTOX_SECRET=
# Must exactly match the redirect URI registered in your Upstox developer
# app, and the URL your API is actually reachable at for the OAuth callback.
UPSTOX_REDIRECT_URI=http://localhost:8000/brokers/upstox/callback

# Worker process only (see docker-compose.yml's `worker` service and
# app/workers/main.py). Comma-separated symbols to drive the market data
# feed, and an optional "SYMBOL=instrument-uuid" mapping so closed candles
# get persisted against the right instrument row.
WORKER_SYMBOLS=
WORKER_INSTRUMENT_IDS=
