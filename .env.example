# Copy to .env and fill in real values. Never commit the real .env file.

# "development" (the default) accepts the placeholder secrets below so
# local dev/tests work with zero configuration. Set this to "production"
# in any real deployment -- doing so makes the app refuse to start if
# JWT_SECRET or CREDENTIALS_ENCRYPTION_KEY is still blank or a placeholder,
# or if DEBUG is still true
# (see app/core/config.py's Settings._refuse_unsafe_defaults_in_production).
ENVIRONMENT=development

# true is the development default and is refused under
# ENVIRONMENT=production: it returns raw exception text -- including the
# failing SQL statement -- to clients on every 500, and echoes every SQL
# statement to the logs.
DEBUG=true

DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
# Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Comma/JSON-list of allowed browser origins, e.g. ["https://app.example.com"].
# Empty (the default) denies all cross-origin requests.
CORS_ORIGINS=

# Brute-force protection on /auth/login and /auth/register. Leave true in
# production; tests set this to false themselves (every request in a test
# suite shares one client "IP").
RATE_LIMIT_ENABLED=true

# How many trusted reverse proxies sit in front of the API. 0 means none:
# the limiter keys on the socket peer, which is then the real client.
# Behind a proxy that peer is the *proxy*, identically for everyone, so
# the per-IP limit becomes one global bucket and the eleventh person to
# log in that minute gets a 429. Set this to the number of proxies you
# actually run -- 1 for infrastructure/nginx/nginx.conf.example -- and the
# limiter reads that many entries back from the right of X-Forwarded-For.
# Leave it 0 with no proxy in front: honouring the header then lets any
# client forge its own address.
TRUSTED_PROXY_HOPS=0

# Market data only. Deliberately NOT a connected broker account: storing a
# token as a BrokerAccount makes resolve_broker route that user's real
# orders to Upstox (execution_mode LIVE). This one is process-wide, creates
# no account row, and is read only by app/market/providers/upstox.py, which
# has no method that can place an order — so execution stays paper.
#
# Upstox issues no read-only market-data token: this value CAN trade
# through any other client. Store it like a trading credential. Upstox
# expires it daily (~03:30 IST), so a multi-day run needs re-auth.
UPSTOX_DATA_ACCESS_TOKEN=

AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

DHAN_CLIENT_ID=
DHAN_SECRET=

UPSTOX_CLIENT_ID=
UPSTOX_SECRET=
# Must exactly match the redirect URI registered in your Upstox developer
# app, and the URL your API is actually reachable at for the OAuth callback.
UPSTOX_REDIRECT_URI=http://localhost:8000/brokers/upstox/callback

# Worker process only (see docker-compose.yml's `worker` service and
# app/workers/main.py). Comma-separated symbols to drive the market data
# feed, and an optional "SYMBOL=instrument-uuid" mapping so closed candles
# get persisted against the right instrument row.
WORKER_SYMBOLS=
WORKER_INSTRUMENT_IDS=
